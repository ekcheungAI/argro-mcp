# Example environment values for LOCAL development (docker-compose.example.yml).
# Copy to infra/.env and adjust. See ENVIRONMENT-VARS.md for the full reference.
# NEVER commit real secrets.

# --- PostgreSQL (local container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=argro

# --- Backend / Worker (backend/app/config.py) ---
# Full SQLAlchemy URL; compose builds it from POSTGRES_* above, but you can
# override it directly (e.g. to point at an external DB).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/argro
APP_ENV=dev
BACKEND_PORT=8000
# Optional API key auth for the backend. Leave empty to disable auth.
# When set, the MCP server must use the SAME value.
API_KEY=

# LLM / embeddings (Moonshot / Kimi)
MOONSHOT_API_KEY=sk-your-moonshot-key-here
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
EMBEDDING_MODEL=text-embedding-3-small
TRANSLATION_MODEL=kimi-k2
TARGET_LANGS=en,zh-TW

# Ingestion tuning
INGESTION_BATCH_SIZE=50
INGESTION_INTERVAL_MINUTES=15
WORKER_CONCURRENCY=4

# CORS origins for the backend (comma-separated; default "*").
# CORS_ORIGINS=http://localhost:3000

# --- MCP server (mcp-server/) ---
# Inside compose this is overridden to http://backend:8000.
MCP_BACKEND_URL=http://localhost:8000
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100

# --- Frontend (Next.js) ---
# Public URL of the backend as seen by the browser / server components.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
